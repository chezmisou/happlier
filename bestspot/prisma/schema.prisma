// Prisma schema for bestspot.
// Uses PostgreSQL — point DATABASE_URL at Vercel Postgres / Neon / Supabase.
// For local SQLite dev, swap `provider = "sqlite"` and use
// DATABASE_URL="file:./dev.db".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL used at runtime (PgBouncer / Supabase pooler, port 6543).
  url       = env("DATABASE_URL")
  // Direct connection URL used by `prisma migrate` (port 5432). Falls back
  // to DATABASE_URL when not set, but the migrate step will be unreliable
  // through PgBouncer transaction mode if you do.
  directUrl = env("DIRECT_URL")
}

model Place {
  id               String   @id @default(cuid())
  userId           String   @default("default-user")

  // Canonical data (Google Places)
  googlePlaceId    String?  @unique
  name             String
  formattedAddress String?
  latitude         Float
  longitude        Float
  rating           Float?
  userRatingsTotal Int?
  googleMapsUrl    String?
  websiteUrl       String?
  photoUrl         String?

  // Categorization
  placeType        String   // restaurant | bar | cafe | activity | hotel | shop | other

  // Source
  sourceType       String   // tiktok | instagram | google_maps | manual
  sourceUrl        String

  // Extracted insights
  reviewExcerpt    String?
  sentiment        String?  // positive | neutral | negative

  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([placeType])
}
