# --- Anthropic ---
# Used server-side to extract structured place info from social posts.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Google Cloud ---
# In the same Google Cloud project, enable:
#   - Maps JavaScript API
#   - Places API (New)   (NOT the legacy Places API)
#   - Geocoding API (optional fallback)
#
# Create TWO separate API keys for safety:
#   1. A browser-restricted key (HTTP referrer) for client-side Maps JS.
#   2. A server-restricted key (IP / no referrer) for Places API calls.
#
# Browser key (exposed to the client). Restrict to your domain(s).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side key for Places API (New). NEVER prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# (Optional) Map ID for AdvancedMarkers / styled maps. Create one at
# https://console.cloud.google.com/google/maps-apis/studio/maps
# Without it, AdvancedMarker still renders but you lose vector / theming support.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime (PgBouncer transaction mode).
# Supabase: dashboard → Project Settings → Database → "Transaction Pooler"
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Vercel Postgres / Neon: use the value Vercel injects automatically.
DATABASE_URL=

# Non-pooled URL used ONLY by `prisma migrate`. Must support session-mode
# features (advisory locks, prepared statements).
#
# IMPORTANT for Supabase + Vercel: do NOT use the "Direct connection"
# (db.<ref>.supabase.co:5432) — it is IPv6-only and unreachable from Vercel
# builders. Use the "Session Pooler" instead (same pooler host, port 5432):
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=
